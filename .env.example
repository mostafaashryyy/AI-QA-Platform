# ------------------------------------------------------------------
# AI QA Platform — automation environment variables (REFERENCE ONLY)
#
# The generated automation projects read these values from the process
# environment. They do NOT load this file automatically. Export the variables
# in your shell or set them in your IDE run configuration.
#
# Never commit a filled-in copy. `.env` and `.env.*` are git-ignored.
# ------------------------------------------------------------------

# Base URL of the application under test (non-secret; scaffold default is the
# task's UI entry point).
QA_BASE_URL=https://app.example.test

# Browser. Playwright bindings: chromium | firefox | webkit
#          SHAFT binding:       chromium (or chrome) | firefox | edge
QA_BROWSER=chromium

# true | false
QA_HEADLESS=true

# Per-step timeout in milliseconds
QA_TIMEOUT_MS=15000

# Evidence root, relative to the generated project directory
# (scaffold default points at the task's automation-execution/results/ folder)
QA_ARTIFACTS_DIR=

# Run identifier. Set by automation-execution for each run; a local-<timestamp>
# value is generated when empty.
QA_RUN_ID=

# Credentials. The variable NAMES are chosen per task during automation-generation
# and recorded in automation/AutomationGeneration.md. Values are never stored in
# the repository, journals, reports or evidence.
# Example names only:
APP_USERNAME=
APP_PASSWORD=
